<Window x:Class="AiMusicWorkstation.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Music Workstation" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="1000" MinHeight="600"
        Background="#121212">
    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="Content" Value="M"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#8B0000"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="IndianRed"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="Content" Value="S"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#7A6000"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="Gold"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="VolumeInputBox">
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="IBeam"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2E3D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LibraryColumn"  Width="240"/>
            <ColumnDefinition x:Name="ChordColumn"    Width="260"/>
            <ColumnDefinition                          Width="*"/>
            <ColumnDefinition x:Name="SectionsColumn" Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LIBRARY (kolumn 0) ===== -->
        <Grid Grid.Column="0" Background="#181818">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="12,16,12,8">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LIBRARY" Foreground="#888" FontWeight="Bold"
                               FontSize="11" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="⟳ Refresh"
                            Click="RefreshMetadata_Click"
                            Background="#1A2E3D" Foreground="#007ACC"
                            FontSize="10" FontWeight="Bold"
                            Padding="6,3" Cursor="Hand"/>
                </Grid>
                <Border Background="#2A2A2A" CornerRadius="5" Padding="8,5" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding Library.SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="White" CaretBrush="White"
                             VerticalContentAlignment="Center"/>
                </Border>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SortCombo" Grid.Column="0"
                              SelectionChanged="Filter_Changed" SelectedIndex="0"
                              Background="#333" Foreground="Black" FontSize="11">
                        <ComboBoxItem Content="Latest"/>
                        <ComboBoxItem Content="A-Z"/>
                        <ComboBoxItem Content="BPM"/>
                    </ComboBox>
                    <ComboBox x:Name="GenreCombo" Grid.Column="2"
                              SelectionChanged="Filter_Changed" SelectedIndex="0"
                              Background="#333" Foreground="Black" FontSize="11">
                        <ComboBoxItem Content="All Genres"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
            <ListBox x:Name="ProjectList" Grid.Row="1"
                     ItemsSource="{Binding Library.Projects}"
                     PreviewMouseRightButtonDown="ProjectList_PreviewRightClick"
                     Background="Transparent" BorderThickness="0"
                     SelectionChanged="ProjectList_SelectionChanged"
                     Margin="8,0,8,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3" Background="Transparent" Tag="{Binding}">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✏️ Rename" Click="Rename_Click"
                                              Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="📁 Move to Group..." Click="MoveToGroup_Click"
                                              Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="❌ Delete" Click="Delete_Click"
                                              Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#007ACC" CornerRadius="2" Margin="0,2"/>
                            <StackPanel Grid.Column="1" Margin="8,4,4,4">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artist}"
                                           FontSize="11" Foreground="#999"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Bpm, StringFormat={}{0:F0}}"
                                               Foreground="#555" FontSize="10"/>
                                    <TextBlock Text=" BPM • " Foreground="#444" FontSize="10"/>
                                    <TextBlock Text="{Binding Key}"
                                               Foreground="#555" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text=" • " Foreground="#444" FontSize="10"/>
                                    <TextBlock Text="{Binding Genre}"
                                               Foreground="#666" FontSize="10" FontStyle="Italic"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center"
                                               Fill="#007ACC" Opacity="0.4"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Foreground="#007ACC" FontSize="10"
                                               FontWeight="Bold" Opacity="0.8"
                                               Margin="8,0" VerticalAlignment="Center"/>
                                    <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                                               Fill="#007ACC" Opacity="0.4"/>
                                </Grid>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
        </Grid>

        <!-- ===== CHORD/SCALE PANEL (kolumn 1) ===== -->
        <Grid x:Name="ChordPanel" Grid.Column="1" Background="#161616">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Next chords toppen -->
            <Border Grid.Row="0" Background="#111" Padding="12,10"
                    BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
                <TextBlock x:Name="NextChordsText" Text="— — —"
                           Foreground="#007ACC" FontSize="16" FontWeight="Bold"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Flik-knappar -->
            <Grid Grid.Row="1" Margin="10,10,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="TabChordBtn" Grid.Column="0"
                              Content="Chord" IsChecked="True"
                              Click="TabChord_Click" Height="30" FontSize="12">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="#252525"/>
                            <Setter Property="Foreground" Value="#888"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#2A5A7A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2a2a2a"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton x:Name="TabScaleBtn" Grid.Column="1"
                              Content="Scale" Click="TabScale_Click" Height="30" FontSize="12">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="#252525"/>
                            <Setter Property="Foreground" Value="#888"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#2A5A7A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2a2a2a"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>

            <!-- Chord-vy -->
            <Grid Grid.Row="2">
                <StackPanel x:Name="ChordView"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentChordText" Text="--"
                   Foreground="Gold" FontSize="40" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,8,0,6"/>
                    <Border x:Name="ChordDiagramHost"
                HorizontalAlignment="Center"
                Background="Transparent" Margin="0,0,0,16"/>
                    <ItemsControl x:Name="UpcomingChordsPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding ChordName}"
                                   Foreground="#888" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Border x:Name="DiagramContainer"
                                HorizontalAlignment="Center"
                                Loaded="UpcomingDiagram_Loaded"
                                Tag="{Binding ChordName}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Scale-vy -->
                
                <StackPanel x:Name="ScaleView" Visibility="Collapsed"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="10,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="PentatonicBtn" Grid.Column="0"
                          Content="Penta" IsChecked="True"
                          Click="ScaleToggle_Click" Height="26" FontSize="11">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="Foreground" Value="#888"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#2A5A7A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <ToggleButton x:Name="MajorScaleBtn" Grid.Column="1"
                          Content="Maj/Min" Click="ScaleToggle_Click" Height="26" FontSize="11">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="Foreground" Value="#888"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#2A5A7A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                    <TextBlock x:Name="ScaleKeyText" Text=""
                   Foreground="#aaa" FontSize="13"
                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Border x:Name="ScaleDiagramHost"
                HorizontalAlignment="Center"
                Background="Transparent" ClipToBounds="True"/>
                </StackPanel>
            </Grid>
        </Grid>
            <!-- ===== HUVUDINNEHÅLL (mitten, kolumn 2) ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="20,12,20,8">
                <TextBlock Text="AI MUSIC WORKSTATION" Foreground="White"
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MASTER VOL" Foreground="Gray" VerticalAlignment="Center"
                               Margin="0,0,10,0" FontSize="10" FontWeight="Bold"/>
                    <Slider Width="100" Minimum="0" Maximum="1" Value="1"
                            IsMoveToPointEnabled="True" Name="SliderMaster" Tag="master"
                            ValueChanged="MasterVolume_Changed"
                            PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                            VerticalAlignment="Center"/>
                    <TextBox x:Name="InputMasterVol" Text="100" Width="35" Margin="8,0,0,0"
                             VerticalAlignment="Center" Style="{StaticResource VolumeInputBox}"
                             Tag="master" KeyDown="VolumeInput_KeyDown" LostFocus="VolumeInput_LostFocus"/>
                    <TextBlock Text="%" Foreground="#555" VerticalAlignment="Center"
                               Margin="2,0,0,0" FontSize="10"/>
                </StackPanel>
            </Grid>

            <!-- IMPORT + STATUS -->
            <StackPanel Grid.Row="1" Margin="20,0,20,8">
                <Border x:Name="ImportSection" Margin="0,0,0,6">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="YoutubeLinkBox" Height="40"
                                     Style="{StaticResource VolumeInputBox}"
                                     TextAlignment="Left" Padding="12,0"
                                     VerticalContentAlignment="Center" FontSize="13"
                                     Foreground="#AAA"
                                     GotFocus="YoutubeBox_GotFocus"
                                     LostFocus="YoutubeBox_LostFocus"
                                     Text="Paste YouTube or Spotify Link here..."/>
                            <Button Grid.Column="1" Content="⬇ DOWNLOAD"
                                    Click="YoutubeDownload_Click"
                                    Width="130" Height="40" Margin="8,0,0,0"
                                    Background="#CC0000" Foreground="White"
                                    FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                        <Button Content="📂 OPEN LOCAL AUDIO FILE"
                                Click="ImportButton_Click"
                                Width="260" Height="36" Background="#2A2A2A"
                                Foreground="White" FontWeight="Bold"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusLabel" Text="Ready"
                           Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <ProgressBar x:Name="AnalysisProgress" IsIndeterminate="True"
                             Height="3" Visibility="Hidden"
                             Foreground="#007ACC" Background="#222"
                             BorderThickness="0" Margin="0,0,0,4"/>
                <Button x:Name="ShowImportBtn" Content="＋ Add Song"
                        Visibility="Collapsed" Click="ShowImport_Click"
                        Width="110" Height="30" Background="#1A2E3D" Foreground="#007ACC"
                        FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                        Margin="0,0,0,4" Cursor="Hand"/>
            </StackPanel>

            <!-- TEMPO + KEY + TRANSPOSE -->
            <StackPanel Grid.Row="2" Margin="20,0,20,8">
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="TEMPO" Foreground="#555"
                                   HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="BpmText" Text="--" Foreground="#007ACC"
                                   FontSize="48" FontWeight="Bold" Cursor="Hand"
                                   Background="Transparent" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                            <Border x:Name="OfficialBadge" Visibility="Collapsed"
                                    Background="#1DB954" CornerRadius="10" Padding="7,2">
                                <TextBlock Text="✓ SPOTIFY" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <Border x:Name="AiBadge" Visibility="Collapsed"
                                    Background="#333" CornerRadius="10" Padding="7,2">
                                <TextBlock Text="⚡ AI ANALYSIS" Foreground="#888" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TIME SIG" Foreground="#555"
                                   HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="TimeSigText" Text="--" Foreground="#007ACC"
                                   FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Border Background="#333" CornerRadius="10" Padding="7,2"
                                HorizontalAlignment="Center" Margin="0,3,0,0">
                            <TextBlock x:Name="TimeSigBadge" Text="⚡ AI ANALYSIS"
                                       Foreground="#888" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="KEY" Foreground="#555"
                                   HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="KeyText" Text="--" Foreground="#007ACC"
                                   FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                            <Border x:Name="KeyOfficialBadge" Visibility="Collapsed"
                                    Background="#1DB954" CornerRadius="10" Padding="7,2">
                                <TextBlock Text="✓ SPOTIFY" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <Border x:Name="KeyAiBadge" Visibility="Collapsed"
                                    Background="#333" CornerRadius="10" Padding="7,2">
                                <TextBlock Text="⚡ AI ANALYSIS" Foreground="#888" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </UniformGrid>

                <!-- TRANSPOSE + METRONOM -->
                <Border Background="#1A1A1A" CornerRadius="10" Padding="12,7"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TRANSPOSE" Foreground="#555" FontSize="10"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="TransposeDownBtn" Content="−" Width="30" Height="30"
                                Background="#2A2A2A" Foreground="White" FontSize="16"
                                Click="TransposeDown_Click" Cursor="Hand"/>
                        <Border Background="#222" CornerRadius="6" Padding="10,4" Margin="5,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TransposeLabel" Text="0"
                                           Foreground="#007ACC" FontSize="16" FontWeight="Bold"
                                           MinWidth="18" TextAlignment="Center"/>
                                <TextBlock Text=" st" Foreground="#555" FontSize="10"
                                           VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="TransposeUpBtn" Content="+" Width="30" Height="30"
                                Background="#2A2A2A" Foreground="White" FontSize="16"
                                Click="TransposeUp_Click" Cursor="Hand"/>
                        <Button Content="↺" Width="30" Height="30" Margin="5,0,0,0"
                                Background="#2A2A2A" Foreground="#888" FontSize="14"
                                Click="TransposeReset_Click" Cursor="Hand"
                                ToolTip="Reset to original key"/>
                        <Border Background="#1A1A1A" CornerRadius="6" Padding="8,4" Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="MetronomePulse" Width="9" Height="9"
                                        Background="#007ACC" CornerRadius="5"
                                        Opacity="0.2" Margin="0,0,7,0"/>
                                <ComboBox x:Name="TimeSignatureCombo" Width="52"
                                          Background="#333" Foreground="Black"
                                          FontSize="11" Margin="0,0,7,0" SelectedIndex="0">
                                    <ComboBoxItem Content="4/4"/>
                                    <ComboBoxItem Content="3/4"/>
                                    <ComboBoxItem Content="6/8"/>
                                    <ComboBoxItem Content="2/4"/>
                                </ComboBox>
                                <ToggleButton x:Name="CountInBtn" Content="Count In"
                                              FontSize="10" FontWeight="Bold"
                                              Padding="6,4" Cursor="Hand" Margin="0,0,7,0"
                                              ToolTip="Inräkning innan låten startar">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="#2A2A2A"/>
                                            <Setter Property="Foreground" Value="#888"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#1A3A2A"/>
                                                    <Setter Property="Foreground" Value="#1DB954"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <TextBlock x:Name="MetronomeBeatText" Text=""
                                           Foreground="#007ACC" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,7,0" MinWidth="44"/>
                                <ToggleButton x:Name="MetronomeBtn" Content="🥁 Metro"
                                              Click="MetronomeToggle_Click"
                                              Background="#2A2A2A" Foreground="White"
                                              FontSize="11" FontWeight="Bold"
                                              Padding="8,4" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- LYRICS -->
            <Grid Grid.Row="3" Margin="20,8,20,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="LYRICS" Foreground="#555"
                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="ToggleLyricsBtn"
                                  Content="📝" ToolTip="Visa/dölj lyrics"
                                  Width="26" Height="26" FontSize="13"
                                  IsChecked="True" Click="ToggleLyrics_Click"
                                  Background="#2A2A2A" Foreground="White"
                                  HorizontalAlignment="Right"/>
                </Grid>
                <Border x:Name="LyricsPanel" Grid.Row="1"
        Background="#1E1E1E" CornerRadius="12"
        SizeChanged="LyricsPanel_SizeChanged">
                    <ScrollViewer x:Name="LyricsScroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LyricsList"
                      Padding="20,12"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="LyricTextBlock"
                               Text="{Binding Text}"
                               FontSize="{Binding FontSize}"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Cursor="Hand"
                               HorizontalAlignment="Stretch"
                               MouseDown="LyricsLine_Click">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#555"/>
                                                <Setter Property="Margin" Value="0,3"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- MIXER -->
            <UniformGrid Grid.Row="4" Columns="4" Margin="20,0,20,8">
                <StackPanel Margin="8,0">
                    <TextBlock Text="DRUMS" Foreground="#888"
                               HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBox x:Name="InputDrums" Text="80" Width="35"
                                 Style="{StaticResource VolumeInputBox}" Tag="drums"
                                 KeyDown="VolumeInput_KeyDown" LostFocus="VolumeInput_LostFocus"/>
                        <TextBlock Text="%" Foreground="#555" VerticalAlignment="Center"
                                   FontSize="11" Margin="2,0,0,0"/>
                    </StackPanel>
                    <Slider Orientation="Vertical" Height="120" Minimum="0" Maximum="1"
                            Value="0.8" IsMoveToPointEnabled="True" Name="VolDrums"
                            ValueChanged="Volume_Changed"
                            PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                            Tag="drums" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <ToggleButton Content="M" Width="32" Height="28" Margin="2"
                                      Foreground="IndianRed" Tag="drums" Click="Mute_Click"/>
                        <ToggleButton Content="S" Width="32" Height="28" Margin="2"
                                      Foreground="Gold" Tag="drums" Click="Solo_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="BASS" Foreground="#888"
                               HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBox x:Name="InputBass" Text="80" Width="35"
                                 Style="{StaticResource VolumeInputBox}" Tag="bass"
                                 KeyDown="VolumeInput_KeyDown" LostFocus="VolumeInput_LostFocus"/>
                        <TextBlock Text="%" Foreground="#555" VerticalAlignment="Center"
                                   FontSize="11" Margin="2,0,0,0"/>
                    </StackPanel>
                    <Slider Orientation="Vertical" Height="120" Minimum="0" Maximum="1"
                            Value="0.8" IsMoveToPointEnabled="True" Name="VolBass"
                            ValueChanged="Volume_Changed"
                            PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                            Tag="bass" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <ToggleButton Content="M" Width="32" Height="28" Margin="2"
                                      Foreground="IndianRed" Tag="bass" Click="Mute_Click"/>
                        <ToggleButton Content="S" Width="32" Height="28" Margin="2"
                                      Foreground="Gold" Tag="bass" Click="Solo_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="OTHER" Foreground="#888"
                               HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBox x:Name="InputOther" Text="80" Width="35"
                                 Style="{StaticResource VolumeInputBox}" Tag="other"
                                 KeyDown="VolumeInput_KeyDown" LostFocus="VolumeInput_LostFocus"/>
                        <TextBlock Text="%" Foreground="#555" VerticalAlignment="Center"
                                   FontSize="11" Margin="2,0,0,0"/>
                    </StackPanel>
                    <Slider Orientation="Vertical" Height="120" Minimum="0" Maximum="1"
                            Value="0.8" IsMoveToPointEnabled="True" Name="VolOther"
                            ValueChanged="Volume_Changed"
                            PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                            Tag="other" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <ToggleButton Content="M" Width="32" Height="28" Margin="2"
                                      Foreground="IndianRed" Tag="other" Click="Mute_Click"/>
                        <ToggleButton Content="S" Width="32" Height="28" Margin="2"
                                      Foreground="Gold" Tag="other" Click="Solo_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="VOCALS" Foreground="#888"
                               HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBox x:Name="InputVocals" Text="80" Width="35"
                                 Style="{StaticResource VolumeInputBox}" Tag="vocals"
                                 KeyDown="VolumeInput_KeyDown" LostFocus="VolumeInput_LostFocus"/>
                        <TextBlock Text="%" Foreground="#555" VerticalAlignment="Center"
                                   FontSize="11" Margin="2,0,0,0"/>
                    </StackPanel>
                    <Slider Orientation="Vertical" Height="120" Minimum="0" Maximum="1"
                            Value="0.8" IsMoveToPointEnabled="True" Name="VolVocals"
                            ValueChanged="Volume_Changed"
                            PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                            Tag="vocals" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <ToggleButton Content="M" Width="32" Height="28" Margin="2"
                                      Foreground="IndianRed" Tag="vocals" Click="Mute_Click"/>
                        <ToggleButton Content="S" Width="32" Height="28" Margin="2"
                                      Foreground="Gold" Tag="vocals" Click="Solo_Click"/>
                    </StackPanel>
                </StackPanel>
            </UniformGrid>

            <!-- TRANSPORT -->
            <StackPanel Grid.Row="5" Margin="20,0,20,12">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                               Text="00:00" Foreground="#888"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Button Grid.Column="1" Content="«" Width="30" Height="24"
                            Background="#222" Foreground="#888" FontSize="13"
                            Click="SeekBack_Click" Cursor="Hand" ToolTip="Back 10 seconds"/>
                    <Slider Grid.Column="2" x:Name="TimelineSlider"
                            Minimum="0" Maximum="100"
                            IsMoveToPointEnabled="True"
                            Thumb.DragStarted="Timeline_DragStarted"
                            Thumb.DragCompleted="Timeline_DragCompleted"
                            ValueChanged="Timeline_ValueChanged"
                            VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="»" Width="30" Height="24"
                            Background="#222" Foreground="#888" FontSize="13"
                            Click="SeekForward_Click" Cursor="Hand" ToolTip="Forward 10 seconds"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="4"
                               Text="00:00" Foreground="#888"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ToggleButton x:Name="LoopBtn" Content="🔁" Width="46" Height="46"
                                  Click="Loop_Click" Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#222"/>
                                <Setter Property="Foreground" Value="#555"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="#1A3A2A"/>
                                        <Setter Property="Foreground" Value="#1DB954"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button x:Name="PlayPauseBtn" Content="▶" Width="70" Height="70"
                            Margin="16,0" Background="#1DB954" Foreground="White"
                            FontSize="32" Click="PlayPause_Click" Cursor="Hand"/>
                    <Button Content="⏮" Width="46" Height="46"
                            Background="#222" Foreground="IndianRed"
                            FontSize="18" Click="Stop_Click"
                            Cursor="Hand" ToolTip="Restart &amp; Play"/>
                    <Button x:Name="ExportBtn" Content="💾 EXPORT MIX"
                            Click="ExportMix_Click" Width="130" Height="46"
                            Margin="24,0,0,0" Background="#007ACC"
                            Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <!-- Toggle-knappar overlay, alltid synliga -->
            <ToggleButton x:Name="ToggleChordsBtn"
                          Grid.Row="5"
                          Content="🎸" ToolTip="Visa/dölj ackordpanel"
                          Width="26" Height="26" FontSize="13"
                          IsChecked="True" Click="ToggleChords_Click"
                          Background="#2A2A2A" Foreground="White"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,0"
                          Panel.ZIndex="99"/>

            <ToggleButton x:Name="ToggleSectionsBtn"
                          Grid.Row="5"
                          Content="🎼" ToolTip="Visa/dölj sections"
                          Width="26" Height="26" FontSize="13"
                          IsChecked="True" Click="ToggleSections_Click"
                          Background="#2A2A2A" Foreground="White"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Right"
                          Margin="0,0,0,0"
                          Panel.ZIndex="99"/>
        </Grid>
        <!-- ===== SECTIONS/STRUCTURE PANEL (kolumn 3) ===== -->
        <Border x:Name="SectionsPanel" Grid.Column="3" Background="#161616">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="10,12"
                        BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
                    <TextBlock Text="STRUCTURE" Foreground="#555"
                               FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SectionsList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        Padding="8,8,8,8"
                                        Cursor="Hand"
                                        Focusable="False"
                                        FocusVisualStyle="{x:Null}"
                                        MouseDown="SectionItem_MouseDown"
                                        MouseLeftButtonDown="SectionItem_DoubleClick">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1A2530"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#0D2035"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                Margin="0,0,10,0" Background="{Binding ColorBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                   VerticalAlignment="Center"
                                                   FontSize="14" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#AAA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}"
                                                   VerticalAlignment="Center" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#555"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="#2A5A7A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="❌ Remove" Click="RemoveSection_Click"
                                                      Tag="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#111" Padding="8,6"
                        BorderThickness="0,1,0,0" BorderBrush="#2A2A2A">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="SectionsEditBtn" Grid.Column="0"
                                      Content="✏️ Edit" Click="SectionsEdit_Click"
                                      Background="#2A2A2A" Foreground="#888"
                                      FontSize="11" FontWeight="SemiBold"
                                      Padding="8,4" Height="28" Cursor="Hand"/>
                        <Grid x:Name="SectionsEditBar" Grid.Column="1"
                              Visibility="Collapsed" Margin="6,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SectionTypeCombo" Grid.Column="0"
                                      Background="#222" Foreground="White"
                                      FontSize="11" BorderThickness="0"
                                      SelectedIndex="0" Height="24">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="#222"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBoxItem Content="Intro"/>
                                <ComboBoxItem Content="Verse"/>
                                <ComboBoxItem Content="Pre"/>
                                <ComboBoxItem Content="Chorus"/>
                                <ComboBoxItem Content="Bridge"/>
                                <ComboBoxItem Content="Solo"/>
                                <ComboBoxItem Content="Instrumental"/>
                                <ComboBoxItem Content="Outro"/>
                                <ComboBoxItem Content="Break"/>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Add"
                                    Click="AddSection_Click"
                                    Background="#2A5A7A" Foreground="White"
                                    FontSize="11" FontWeight="Bold"
                                    Padding="8,3" Margin="4,0,0,0"
                                    Cursor="Hand" Height="24"/>
                        </Grid>
                        <Button x:Name="AutoDetectBtn" Grid.Column="2"
                                Content="🤖" Click="AutoDetectStructure_Click"
                                Background="#2A2A2A" Foreground="#888"
                                FontSize="14" Width="28" Height="28"
                                Cursor="Hand" Margin="4,0,0,0"
                                ToolTip="Auto-detect structure via AI"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>