{
  "lyrics": [
    {
      "start": 0,
      "end": 24.88,
      "text": "Well, I took a walk around the world to ease my troubled mind",
      "IsActive": true
    },
    {
      "start": 24.88,
      "end": 29.68,
      "text": "I left my body lying somewhere in the sands of time",
      "IsActive": false
    },
    {
      "start": 29.68,
      "end": 34.56,
      "text": "Well, I watched the world float to the dark side of the moon",
      "IsActive": false
    },
    {
      "start": 34.56,
      "end": 49.2,
      "text": "Well, I feel there\u0027s nothing I can do, yeah",
      "IsActive": false
    },
    {
      "start": 49.2,
      "end": 54.239999999999995,
      "text": "I watched the world float to the dark side of the moon",
      "IsActive": false
    },
    {
      "start": 54.24,
      "end": 58.88,
      "text": "After all, I knew it had to be something to do with you",
      "IsActive": false
    },
    {
      "start": 58.88,
      "end": 63.28,
      "text": "I really don\u0027t mind what happens now and then",
      "IsActive": false
    },
    {
      "start": 63.28,
      "end": 68.48,
      "text": "As long as you\u0027ll be my friend at the end",
      "IsActive": false
    },
    {
      "start": 68.48,
      "end": 73.36,
      "text": "If I go crazy, then will you still call me Superman?",
      "IsActive": false
    },
    {
      "start": 73.36,
      "end": 78.24000000000001,
      "text": "If I\u0027m alive, then will you be there holding my hand?",
      "IsActive": false
    },
    {
      "start": 78.24000000000001,
      "end": 82.48,
      "text": "I\u0027ll keep you by my side with my superhuman",
      "IsActive": false
    },
    {
      "start": 82.56,
      "end": 97.60000000000001,
      "text": "My kryptonite",
      "IsActive": false
    },
    {
      "start": 97.60000000000001,
      "end": 102.56,
      "text": "You called me strong, you called me weak But still your secrets I will keep",
      "IsActive": false
    },
    {
      "start": 102.56,
      "end": 107.28,
      "text": "You took for granted all the times I never let you down",
      "IsActive": false
    },
    {
      "start": 107.28,
      "end": 112.24000000000001,
      "text": "You stumbled in and bumped your head If not for me, then you\u0027d be dead",
      "IsActive": false
    },
    {
      "start": 112.24,
      "end": 115.83999999999999,
      "text": "I picked you up and put you back on solid ground",
      "IsActive": false
